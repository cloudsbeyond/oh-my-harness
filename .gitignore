# Only files intended for a public checkout are admitted.
*
!/.gitignore
!/LICENSE
!/README.md
!/README.zh.md
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/src/
!/src/*.mjs
!/src/capabilities/
!/src/capabilities/*.mjs
!/src/capabilities/*.d.ts
!/bin/
!/bin/oh-my-harness.mjs
!/bin/verify-dsh-app.mjs
!/bin/verify-package.mjs
!/config/
!/config/default.json
!/config/providers.example.json
!/docs/
!/docs/*.md
!/docs/verification/
!/docs/verification/*.md
!/docs/architecture.json
!/docs/architecture.png
!/deploy/
!/deploy/Caddyfile.example
!/deploy/nginx.conf.example
!/test/
!/test/*.test.mjs
!/test/package-verification.test.mjs
!/test/dsh-host-fixture.mjs
!/extensions/
!/extensions/dsh-native/
!/extensions/dsh-native/release.mjs
!/extensions/dsh-native/host-loader.mjs
!/extensions/dsh-native/README.md
!/extensions/dsh-native-codex/
!/extensions/dsh-native-codex/README.md
!/extensions/dsh-native-codex/package.json
!/extensions/dsh-native-codex/*.mjs
!/extensions/dsh-native-codex/vendor/
!/extensions/dsh-native-codex/vendor/LICENSE
!/extensions/dsh-capabilities/
!/extensions/dsh-capabilities/*.mjs
!/extensions/dsh-capabilities/client.js
!/extensions/dsh-capabilities/README.md
!/extensions/dsh-capabilities/icon.svg
!/extensions/dsh-capabilities/locale/
!/extensions/dsh-capabilities/locale/*.json
!/extensions/dsh-voice-input/
!/extensions/dsh-voice-input/*.mjs
!/extensions/dsh-voice-input/*.js
!/extensions/dsh-voice-input/*.json
!/extensions/dsh-voice-input/*.yml
!/extensions/dsh-voice-input/README.md
!/extensions/dsh-voice-input/LICENSE
!/extensions/dsh-voice-input/icon.svg
!/extensions/dsh-voice-input/locale/
!/extensions/dsh-voice-input/locale/*.json

# Optional local Skill source manager. Runtime/staging/receipts stay outside Git.
!/extensions/skill-source-management/
!/extensions/skill-source-management/README.md
!/extensions/skill-source-management/README.zh.md
!/extensions/skill-source-management/manage.py
!/extensions/skill-source-management/skill_source_management/
!/extensions/skill-source-management/skill_source_management/*.py
!/extensions/skill-source-management/tests/
!/extensions/skill-source-management/tests/*.py

# Only the reviewed CI workflows are included.
!/.github/
!/.github/workflows/
!/.github/workflows/skill-source-management.yml
!/.github/workflows/capabilities.yml
