# Only files intended for a public checkout are admitted.
*
!/.gitignore
!/LICENSE
!/README.md
!/README.zh.md
!/package.json
!/package-lock.json
!/src/
!/src/*.mjs
!/bin/
!/bin/oh-my-harness.mjs
!/config/
!/config/default.json
!/config/providers.example.json
!/docs/
!/docs/*.md
!/docs/architecture.json
!/docs/architecture.png
!/deploy/
!/deploy/Caddyfile.example
!/deploy/nginx.conf.example
!/test/
!/test/*.test.mjs
!/extensions/
!/extensions/dsh-native-codex/
!/extensions/dsh-native-codex/README.md
!/extensions/dsh-native-codex/package.json
!/extensions/dsh-native-codex/*.mjs
!/extensions/dsh-native-codex/vendor/
!/extensions/dsh-native-codex/vendor/LICENSE
