{
  "listen": { "port": 8318 },
  "upstream": "http://127.0.0.1:8317/v1",
  "providers": {
    "compatible": {
      "name": "OpenAI-compatible upstream",
      "protocol": "chat",
      "models": [
        { "id": "compat/example", "contextWindow": 32000, "maxTokens": 4096 }
      ],
      "capabilities": ["text", "vision"]
    },
    "claude": {
      "name": "Claude via CLIProxyAPI",
      "protocol": "messages",
      "models": [
        { "id": "claude-example", "contextWindow": 128000, "maxTokens": 8192 }
      ],
      "capabilities": ["text"]
    },
    "gemini": {
      "name": "Gemini via CLIProxyAPI",
      "protocol": "chat",
      "models": [
        { "id": "gemini-example", "contextWindow": 128000, "maxTokens": 8192 }
      ],
      "capabilities": ["text"]
    }
  },
  "defaults": {
    "text": "compatible",
    "vision": "compatible"
  }
}
