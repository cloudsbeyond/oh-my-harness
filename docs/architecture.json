{
  "schemaVersion": 2,
  "project": "oh-my-harness",
  "purpose": "Integrate authorized capabilities and versioned Skill assets with harnesses while preserving host orchestration, sessions and authority.",
  "schemaNote": "Descriptive model, not executable config; schema version is independent of package versions.",
  "host": {
    "primaryExample": "DSH",
    "otherConsumers": [
      "MCP-compatible harnesses and agents",
      "Applications embedding CapabilityRuntime",
      "Supported Skill clients"
    ],
    "owns": [
      "orchestration",
      "sessions and replay history",
      "permissions",
      "Skill triggering",
      "result judgment"
    ]
  },
  "integrations": [
    {
      "id": "capabilities",
      "purpose": "One independent operation with typed evidence or original media",
      "core": "src/capabilities/",
      "entryPoints": [
        {
          "id": "mcp",
          "implementation": [
            "src/http.mjs",
            "src/tools.mjs",
            "src/stdio.mjs"
          ],
          "placement": "Capability Proxy service; optional file adapter on client host"
        },
        {
          "id": "native",
          "implementation": [
            "extensions/dsh-capabilities/"
          ],
          "placement": "DSH host plugin with its own core instance"
        }
      ],
      "providerImplementations": [
        {
          "kind": "model-protocol",
          "status": "implemented",
          "implementation": "src/capabilities/protocol-provider.mjs",
          "sources": [
            "external CLIProxyAPI",
            "existing compatible provider API"
          ]
        },
        {
          "kind": "application-provider",
          "status": "implemented-registration-interface",
          "sources": [
            "local implementation",
            "independently authorized service"
          ],
          "note": "Consumer supplies driver; no bundled local parser or generic remote-harness connector."
        },
        {
          "kind": "independent-harness",
          "status": "requires-dedicated-adapter",
          "sources": [
            "HTTP or MCP service owned by another harness"
          ]
        }
      ]
    },
    {
      "id": "model-native",
      "purpose": "Preserve main-model stream, citations, images and replay semantics",
      "implementation": [
        "extensions/dsh-native-codex/",
        "extensions/dsh-native/"
      ],
      "placement": "harness host",
      "currentSupport": "DSH Codex Responses against reviewed DSH/SDK baselines"
    },
    {
      "id": "skill-assets",
      "purpose": "Reviewed source/version management and host discovery",
      "implementation": [
        "extensions/skill-source-management/"
      ],
      "placement": "optional local CLI, outside request execution",
      "currentSupport": {
        "packages": "standalone Skills",
        "lifecyclePlatform": "macOS",
        "inspection": "portable Python 3.11+",
        "clients": [
          "Codex",
          "Claude Code"
        ]
      }
    }
  ],
  "diagram": {
    "nodes": [
      {
        "id": "host",
        "label": "Harness / Agent",
        "role": "owner"
      },
      {
        "id": "mcp",
        "label": "MCP adapter",
        "role": "delivery"
      },
      {
        "id": "native",
        "label": "Native host adapter",
        "role": "delivery"
      },
      {
        "id": "core",
        "label": "Capability Core",
        "role": "in-process execution"
      },
      {
        "id": "drivers",
        "label": "Provider drivers",
        "role": "adaptation"
      },
      {
        "id": "sources",
        "label": "Compatible APIs / application providers",
        "role": "upstream"
      },
      {
        "id": "model-native",
        "label": "Model-native adapter",
        "role": "main-model adaptation"
      },
      {
        "id": "model-api",
        "label": "Main model API",
        "role": "upstream"
      },
      {
        "id": "skills",
        "label": "Skill source manager",
        "role": "asset lifecycle"
      },
      {
        "id": "assets",
        "label": "Reviewed versioned Skills",
        "role": "asset"
      },
      {
        "id": "discovery",
        "label": "Host Skill discovery",
        "role": "host interface"
      }
    ],
    "edges": [
      {
        "from": "host",
        "to": "mcp",
        "kind": "capability-call"
      },
      {
        "from": "host",
        "to": "native",
        "kind": "capability-call"
      },
      {
        "from": "mcp",
        "to": "core",
        "kind": "in-process-call"
      },
      {
        "from": "native",
        "to": "core",
        "kind": "in-process-call"
      },
      {
        "from": "core",
        "to": "drivers",
        "kind": "execute-operation"
      },
      {
        "from": "drivers",
        "to": "sources",
        "kind": "provider-operation"
      },
      {
        "from": "host",
        "to": "model-native",
        "kind": "main-model-request",
        "direction": "bidirectional"
      },
      {
        "from": "model-native",
        "to": "model-api",
        "kind": "stream-and-replay",
        "direction": "bidirectional"
      },
      {
        "from": "assets",
        "to": "skills",
        "kind": "reviewed-source"
      },
      {
        "from": "skills",
        "to": "discovery",
        "kind": "publication-and-binding"
      },
      {
        "from": "discovery",
        "to": "host",
        "kind": "host-discovery"
      }
    ],
    "note": "Logical responsibilities, not one required process. Skill edges represent asset/discovery flow; model-native has no edge into independent capability execution."
  },
  "deployments": {
    "hostedMcpExample": {
      "ingress": [
        "Caddy",
        "NGINX"
      ],
      "publicRoutes": {
        "model": "https://gateway.example.com/v1",
        "capability": "https://gateway.example.com/mcp"
      },
      "backends": {
        "model": "external CLIProxyAPI at 127.0.0.1:8317",
        "capability": "oh-my-harness MCP at 127.0.0.1:8318"
      }
    },
    "nativeHost": {
      "placement": "harness host",
      "upstreamTransport": [
        "HTTPS remote API",
        "HTTP or WS loopback where supported; WSS for remote audio"
      ],
      "credentials": "Host credential references",
      "requiresMcpServer": false,
      "requiresCliProxyApi": false
    },
    "skillManagement": {
      "placement": "local CLI and host-specific discovery",
      "requiresRuntimeServices": false
    }
  },
  "ownership": {
    "public": [
      "reusable adapters and contracts",
      "examples",
      "tests",
      "version-scoped verification"
    ],
    "private": [
      "real endpoints and host paths",
      "credentials and OAuth",
      "accepted private Skills",
      "receipts and backups",
      "sessions and task outputs"
    ]
  },
  "references": {
    "boundaries": "docs/architecture.md",
    "deployment": "docs/deployment.md",
    "contracts": "docs/capabilities.md",
    "skills": "docs/skill-source-management.md"
  }
}
