{
  "name": "oh-my-harness",
  "version": "0.2.1",
  "private": true,
  "description": "Harness integrations for reusable capabilities, model-native semantics, and versioned Skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.2-rc.3"
  },
  "exports": {
    ".": "./src/capabilities/runtime.mjs",
    "./capabilities": "./src/capabilities/runtime.mjs",
    "./capabilities/contracts": "./src/capabilities/contracts.mjs",
    "./capabilities/protocol": "./src/capabilities/protocol-provider.mjs",
    "./capabilities/realtime": "./src/capabilities/realtime.mjs",
    "./dsh": "./extensions/dsh-capabilities/index.mjs",
    "./prefer-ipv6": "./extensions/dsh-capabilities/prefer-ipv6.mjs",
    "./client": "./extensions/dsh-capabilities/client.js",
    "./locale/*.json": "./extensions/dsh-capabilities/locale/*.json",
    "./icon": "./extensions/dsh-capabilities/icon.svg",
    "./dsh/locale/*.json": "./extensions/dsh-capabilities/locale/*.json",
    "./dsh/icon": "./extensions/dsh-capabilities/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "files": [
    "src/*.mjs", "src/capabilities/*.mjs", "bin/*.mjs",
    "config/default.json", "config/providers.example.json", "deploy/Caddyfile.example", "deploy/nginx.conf.example", "docs/*.md", "docs/verification/*.md", "docs/architecture.png", "docs/architecture.json", "cordis.patch.yml",
    "extensions/dsh-capabilities/*.mjs", "extensions/dsh-capabilities/client.js", "extensions/dsh-capabilities/README.md", "extensions/dsh-capabilities/icon.svg", "extensions/dsh-capabilities/locale/*.json",
    "extensions/dsh-voice-input/*.mjs", "extensions/dsh-voice-input/package.json", "extensions/dsh-voice-input/cordis.patch.yml", "extensions/dsh-voice-input/README.md", "extensions/dsh-voice-input/LICENSE", "extensions/dsh-voice-input/icon.svg", "extensions/dsh-voice-input/locale/*.json",
    "extensions/dsh-native/*.mjs", "extensions/dsh-native/README.md",
    "extensions/dsh-native-codex/*.mjs", "extensions/dsh-native-codex/README.md", "extensions/dsh-native-codex/package.json", "extensions/dsh-native-codex/vendor/LICENSE",
    "test/*.mjs", "LICENSE",
    "extensions/skill-source-management/manage.py", "extensions/skill-source-management/skill_source_management/*.py",
    "extensions/skill-source-management/tests/*.py", "extensions/skill-source-management/README*.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "scripts": {
    "init": "node bin/oh-my-harness.mjs init",
    "proxy": "node bin/oh-my-harness.mjs proxy",
    "start": "node bin/oh-my-harness.mjs start",
    "doctor": "node bin/oh-my-harness.mjs doctor",
    "dsh": "node bin/oh-my-harness.mjs dsh",
    "build:client": "node extensions/dsh-capabilities/build-client.mjs",
    "verify:dsh-app": "node bin/verify-dsh-app.mjs",
    "verify:package": "node bin/verify-package.mjs",
    "test": "node --test test/*.test.mjs",
    "skills": "python3 extensions/skill-source-management/manage.py",
    "test:skills": "python3 -B -m unittest discover -s extensions/skill-source-management/tests -v"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  }
}
